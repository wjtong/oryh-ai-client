# Model used by every person on this ORYH AI Client deployment. Copy to .env and fill in.
# .env is not committed and not copied into the image.
ORYH_MODEL_API_KEY=
ORYH_MODEL_BASE_URL=https://credit.banff-tech.com/v1
ORYH_MODEL=deepseek-v4-flash
# off | low | high | max
ORYH_MODEL_REASONING_EFFORT=high
