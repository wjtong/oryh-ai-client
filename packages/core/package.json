{
  "name": "@oryh/ai-client-core",
  "version": "0.1.0",
  "description": "Host-side connection, credential, and deterministic operation core for ORYH AI Client.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./views": {
      "types": "./lib/record-views.d.ts",
      "default": "./lib/record-views.js"
    },
    "./access": {
      "types": "./lib/access.d.ts",
      "default": "./lib/access.js"
    }
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@oryh/ai-client-foundation": "workspace:*",
    "@oryh/ai-client-pages": "workspace:*",
    "@oryh/ai-client-records": "workspace:*",
    "@oryh/ai-client-store": "workspace:*",
    "@oryh/ai-client-timesheets": "workspace:*"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  }
}
